#!/bin/sh
# mkosi postinst: copy the ABI-matched npm prefix prepared by build-image.sh.
set -eu
ROOT=/buildroot

: "${AHSB_NPM_PREFIX:?build-image.sh must provide the prepared npm prefix}"
printf 'prepared npm prefix: %s\n' "$AHSB_NPM_PREFIX"
test -d "$AHSB_NPM_PREFIX/bin"
test -d "$AHSB_NPM_PREFIX/lib/node_modules"
mkdir -p "$ROOT/usr"
cp -a "$AHSB_NPM_PREFIX/bin" "$AHSB_NPM_PREFIX/lib" "$ROOT/usr/"

NODE_PTY_PACKAGE=$(find "$ROOT/usr/lib/node_modules" -type f -path '*/node-pty/package.json' -print -quit)
test -n "$NODE_PTY_PACKAGE"
NODE_PTY=${NODE_PTY_PACKAGE%/package.json}
test -f "$NODE_PTY/build/Release/pty.node"
node -e "require('$NODE_PTY')"
test -x "$ROOT/usr/bin/claude"
test -x "$ROOT/usr/bin/agent-browser"

systemd-machine-id-setup --root="$ROOT" >/dev/null 2>&1 || true
systemctl --root="$ROOT" mask systemd-firstboot.service
