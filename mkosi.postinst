#!/bin/sh
# mkosi 的 postinst 脚本：在镜像里装两个 harness。
#
# 两个注意点（都是踩过的）：
#   1. mkosi 的脚本沙箱**不是** chroot 进镜像，而是把镜像根挂在 /buildroot，
#      所以一切都得显式指向 $ROOT。脚本沙箱默认无网，靠 mkosi.conf 的
#      [Build] WithNetwork=yes 打开。
#   2. unit 的启停不要在这里用 systemctl enable —— mkosi 之后会跑 preset，
#      把没在预设里的 unit 关掉。启用一律靠 mkosi.skeleton 里的 .wants 软链。
set -eu
ROOT=/buildroot

# 被测的两个 harness，版本在这里钉死：被测对象必须可复现。
# 版本号同时出现在 README 与 task-5 的断言里。
npm install --global --silent --include=optional --prefix "$ROOT/usr" \
    @anthropic-ai/claude-code@2.1.283 \
    @earendil-works/pi-coding-agent@0.87.1

# claude-code 的平台原生二进制由包内 install.cjs 落地。npm 在部分配置下不下载
# optional 依赖，届时会出现 "claude native binary not installed"，所以显式补一次。
node "$ROOT/usr/lib/node_modules/@anthropic-ai/claude-code/install.cjs"

# 消掉 first-boot 向导：它会在串口上追着问时区，让无人值守的运行卡住。
systemd-machine-id-setup --root="$ROOT" >/dev/null 2>&1 || true
systemctl --root="$ROOT" mask systemd-firstboot.service
